# Lark / Feishu App credentials
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxx

# Lark Base settings
LARK_APP_TOKEN=base_app_token_here
LARK_TABLE_ID=tblxxxxxxxxxxxx
# Tên field trong Lark Base. Có thể đổi theo bảng thật.
LARK_FIELD_STATUS=Trạng thái duyệt
LARK_FIELD_SCHEDULE=Thời gian đăng
LARK_FIELD_TITLE=Tiêu đề
LARK_FIELD_CONTENT=Nội dung
LARK_FIELD_DRIVE_FILE=Bài viết trên Drive
LARK_FIELD_FACEBOOK_PAGE=Facebook Page ID
LARK_APPROVED_VALUE=Đã duyệt

# Facebook Graph API
# Meta App OAuth (App Secret không được gửi qua chat)
FACEBOOK_APP_ID=893274256916940
FACEBOOK_APP_SECRET=app_secret_here
# Callback này phải được thêm vào Meta App > Facebook Login > Valid OAuth Redirect URIs
FACEBOOK_REDIRECT_URI=https://datdao5898.github.io/vnwebstudio/fb-callback.html
FACEBOOK_PAGE_ID=61592644081779
FACEBOOK_PAGE_ACCESS_TOKEN=EAABxxxxxxxxxxxx
FACEBOOK_GRAPH_VERSION=v20.0

# App
PORT=8655
APP_TIMEZONE=Asia/Ho_Chi_Minh
SYNC_EVERY_MINUTES=5
DRY_RUN=false

# Bai mau website hang ngay (daily/run-daily.ps1): true = luu nhap tren Page, false = dang thang
DAILY_POST_DRAFT=true

# Trang chủ trên GitHub Pages, dùng để chèn link vào bài đăng hằng ngày
SITE_URL=https://datdao5898.github.io/vnwebstudio/

# Dự án TopKhoaHoc (không bắt buộc: có thể chọn Page trên dashboard)
TOPKHOAHOC_SITE_URL=https://topkhoahoc.online/
